<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
	<!--Specify if custom config name is needed:-->
	<I18nJsonSourceGenConfig>i18nJsonSourceGenConfig.json</I18nJsonSourceGenConfig>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\I18n.Json.SourceGen\I18n.Json.SourceGen.csproj"
					  OutputItemType="Analyzer"
					  ReferenceOutputAssembly="false" />
	<AdditionalFiles Include="i18nJsonSourceGenConfig.json" />
	<AdditionalFiles Include="en.json" />
	<!--Specify if custom config name is needed:-->
	<CompilerVisibleProperty Include="I18nJsonSourceGenConfig" />
  </ItemGroup>

</Project>
